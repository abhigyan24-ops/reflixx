# ==========================================
# 🌿 REFILLX ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in real values
# ==========================================

# ==========================================
# 📧 EMAIL CONFIGURATION
# ==========================================
# For live environments (like Render) that block SMTP ports, use one of these HTTP APIs:
# Only one of these is required for HTTP sending (prioritized in this order)
RESEND_API_KEY=re_your_resend_api_key
# BREVO_API_KEY=xkeysib-your_brevo_api_key
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Fallback / Local SMTP Settings (Render Free Tier blocks ports 587/465)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password

# Supabase Dual-Write Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server Host & Deployment Port (Render / Railway / Heroku inject PORT dynamically)
PORT=8080

# CORS Allowed Origin ('*' for open demo testing, or 'https://your-app.vercel.app' for production)
ALLOWED_ORIGIN=*

# Admin Portal Passcode (for admin.html login protection)
ADMIN_PASSCODE=admin123
